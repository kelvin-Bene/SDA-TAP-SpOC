# Lightweight demo image: Python 3.12 + DuckDB (no Java/Orekit)
FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./

# Install dependencies, skipping orekit-jpype (requires Java)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir duckdb && \
    pip install --no-cache-dir "." --no-deps || \
    pip install --no-cache-dir \
        "fastapi>=0.109.0" \
        "uvicorn>=0.27.0" \
        "python-multipart>=0.0.6" \
        "loguru>=0.7.0" \
        "PyJWT[crypto]>=2.8.0" \
        "python-dotenv" \
        "slowapi>=0.1.9" \
        duckdb

# Remove build-only deps
RUN apt-get purge -y --auto-remove gcc && \
    rm -rf /var/lib/apt/lists/*

COPY uct_benchmark/ ./uct_benchmark/
COPY backend_api/ ./backend_api/
COPY start.py ./

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    DEMO_MODE=true \
    DATABASE_BACKEND=duckdb

RUN mkdir -p /app/data/uploads && \
    groupadd --system appuser && \
    useradd --system --gid appuser --home /app appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "backend_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
