# SDA-TAP-SpOC — DGX Spark local edition environment.
#
# Copy to .env.dgx and edit. docker-compose.dgx.yml reads this file via
# variable substitution (e.g. ${UDL_TOKEN:-}).
#
# Most settings live IN docker-compose.dgx.yml itself (LOCAL_DGX_MODE,
# DEMO_MODE, DATABASE_BACKEND, JAVA_TOOL_OPTIONS, etc.) so they're hard
# defaults that can't accidentally be removed. Only the secrets and a few
# operator-tunable knobs live here.

# =============================================================================
# Service-account credentials for live UDL / ESA pulls
# =============================================================================
# The recommended posture for the delivered DGX Spark is "online + offline
# cache": ship a long-lived service-account token here so that when the box
# IS on a network, fresh data flows from UDL/ESA, and when it ISN'T, the
# bundled DGX_SEED_SAMPLE dataset takes over automatically.
#
# How to provision a UDL service-account token:
#   1. Open https://unifieddatalibrary.com and request a service account from
#      the SDA TAP Lab admin (mark it as "demo box / read-only").
#   2. Base64-encode 'username:password' and put the result below.
#   3. Same for ESA at https://discosweb.esoc.esa.int/tokens (Bearer token,
#      no encoding needed).
#
# IMPORTANT: this file ships ON the DGX Spark, so the token IS on the device.
# Use a service-account credential, not a personal one. Rotate after delivery
# if the box leaves your physical control.
#
# Leave both empty to ship as offline-only (DGX_SEED_SAMPLE is the entire
# experience). Everything still works — the user just can't generate new
# datasets from live data.

UDL_TOKEN=
ESA_TOKEN=

# =============================================================================
# Tuning (rarely changed)
# =============================================================================

# JVM heap for Orekit. The Spark has ~128 GB unified memory so 2 GB is a
# comfortable default; bump to 4–8 GB for very large dataset generations.
# JAVA_TOOL_OPTIONS=-Xmx2g -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# =============================================================================
# AI / LLM model (Phase 2 features only — DGX Spark local edition)
# =============================================================================
# The four AI features (NL→SQL, Explain Results, Chat Assistant, Validator
# Assistant) talk to a local Ollama service that runs alongside the backend
# under the docker-compose `--profile gpu` profile.
#
# The default model bundled by prepare-package.sh is `qwen3.5:35b-a3b`:
#   - 35B total params, 3B active per token (MoE)
#   - ~24 GB on disk (Q4 quantization)
#   - ~25 tok/s on a real DGX Spark (Blackwell GPU)
#   - 256K context window
#   - Apache 2.0 license
#
# Override here to swap models without rebuilding the image. The new model
# must already exist in the dgx_ollama_models docker volume — pull a new
# one with:
#     docker compose --env-file .env.dgx -f docker-compose.dgx.yml \
#         --profile gpu exec ollama ollama pull <tag>
#
# Common alternates (all American-made, GB10-compatible):
#   OLLAMA_MODEL=llama3.1:8b          # default — NVIDIA's Spark reference model, ~4.7 GB
#   OLLAMA_MODEL=llama3.2:3b          # smaller fallback, ~2 GB, same arch family
#   OLLAMA_MODEL=phi3.5:3.8b          # Microsoft, MIT license, ~2.4 GB
#   OLLAMA_MODEL=gemma3:4b            # Google, ~2.5 GB (Gemma 3 — proven on Spark)
#   OLLAMA_MODEL=gpt-oss:20b          # OpenAI, Apache 2.0, ~12 GB (best quality if VRAM allows)
#
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT=120

# =============================================================================
# DO NOT SET in DGX local edition
# =============================================================================
# These would change behavior in ways that contradict the DGX local model:
#
#   SUPABASE_URL / SUPABASE_JWT_SECRET — re-enables Supabase auth
#   DATABASE_URL                       — switches to PostgreSQL backend
#   CORS_ORIGINS                       — disables /docs (left empty so the
#                                        in-browser API explorer is available
#                                        for demos)
#   SENTRY_DSN                         — sends telemetry to a remote service
