# Secrets and credentials
.env
.env.*
*.pem
*.key

# Version control
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Data uploads directory (mounted as volume in production)
# Use /data/ (leading slash) to match only root-level data/, not uct_benchmark/data/ source code
/data/

# Tests and docs (anchored to root with / to avoid matching source code subdirectories)
/tests/
/provided-materials/
/docs/
/validation/
*.md
!README.md

# IDE
.idea
.vscode
*.swp
*.swo

# Build artifacts
frontend/dist
frontend/node_modules
*.timestamp-*
