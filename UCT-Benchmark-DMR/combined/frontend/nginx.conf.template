server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    # Logging
    access_log /dev/stdout;
    error_log /dev/stderr;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.cesium.com; connect-src 'self' https://*.supabase.co https://*.cesium.com https://assets.cesium.com https://*.up.railway.app; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:;" always;

    # Max upload size for UCTP submissions
    client_max_body_size 50m;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;
    gzip_min_length 1000;

    # Use Docker/Railway DNS resolver with short cache for dynamic upstreams
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Cache static assets (JS/CSS with content hashes)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API requests to backend.
    #
    # The backend URL used to come from ${BACKEND_URL} via envsubst so a single
    # template could serve Docker Compose (http://backend:8000), Railway
    # production (http://backend.railway.internal:8000), and Railway demo.
    # That stopped working on 2026-04-22 when Railway's internal DNS
    # (`backend.railway.internal` via resolver 127.0.0.11) started failing to
    # resolve for the frontend container — returning 502 on every /api/ and
    # /health request for the better part of an hour with no platform
    # workaround short of switching the URL entirely.
    #
    # Using the public backend URL (backend-production-4b02.up.railway.app)
    # bypasses Railway's internal networking entirely and uses public DNS,
    # which is always working. Tradeoff: ~50-100ms added latency per request
    # (public edge TLS handshake + routing) vs the guarantee that the
    # frontend proxy survives Railway private-network hiccups. Revert to
    # ${BACKEND_URL}/api/ once Railway's internal DNS is confirmed stable
    # across multiple backend redeploys.
    location /api/ {
        proxy_pass https://backend-production-4b02.up.railway.app/api/;
        proxy_set_header Host backend-production-4b02.up.railway.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name backend-production-4b02.up.railway.app;

        # Long timeout for dataset generation and evaluation jobs
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;

        # Proxy buffer settings
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
        proxy_busy_buffers_size 64k;
    }

    # Proxy health check to backend
    location /health {
        proxy_pass https://backend-production-4b02.up.railway.app/health;
        proxy_set_header Host backend-production-4b02.up.railway.app;
        proxy_ssl_server_name on;
        proxy_ssl_name backend-production-4b02.up.railway.app;
    }

    # SPA fallback: all other routes serve index.html.
    # Without an explicit Cache-Control, Railway's Fastly edge caches
    # index.html for 1 year (its default), which means deploys of new
    # asset-hash chunks are invisible to warm caches. Disable caching on
    # the HTML entry point; assets under /assets/ stay immutable.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}
