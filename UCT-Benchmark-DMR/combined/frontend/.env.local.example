# Copy to .env.local (gitignored) and fill in real values before running
# `npm run test:e2e:prod`.
#
# These drive the Playwright production suite under e2e/prod/. auth.setup.ts
# logs in via the real UI with these credentials and saves a Supabase session
# to e2e/.auth/user.json; authenticated specs reuse it.

PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=

# Defaults if unset — override for staging or local prod replicas.
PLAYWRIGHT_BASE_URL=https://frontend-production-6d80.up.railway.app
PLAYWRIGHT_API_URL=https://backend-production-4b02.up.railway.app
