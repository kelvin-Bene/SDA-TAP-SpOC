# Serve pre-built frontend with nginx reverse proxy to backend
FROM nginx:alpine

# Copy pre-built static files (build locally first with: npm run build)
COPY dist/ /usr/share/nginx/html/

# Copy nginx config template (uses ${PORT} and ${BACKEND_URL} placeholders)
COPY nginx.conf.template /etc/nginx/nginx.conf.template

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Railway provides PORT; BACKEND_URL should be the backend service URL.
#
# Default is the public Railway URL for reliability — on 2026-04-22 Railway's
# private DNS (`backend.railway.internal`) stopped resolving for ~an hour,
# causing all /api/ requests to 502. Using the public URL survives that
# class of outage at the cost of ~50-100ms per request (public edge vs
# internal network). Override in Railway service variables to use the
# internal hostname (http://backend.railway.internal:8000) once private
# networking is confirmed stable.
ENV PORT=3000
ENV BACKEND_URL=https://backend-production-4b02.up.railway.app

# Substitute ONLY our env vars (preserves nginx's $host, $uri, etc.)
# then start nginx
CMD ["sh", "-c", "envsubst '${PORT} ${BACKEND_URL}' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
