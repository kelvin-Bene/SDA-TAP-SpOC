# UCT-Benchmark Environment Configuration
# Copy this file to .env and fill in your credentials
# IMPORTANT: Never commit .env to version control

# =============================================================================
# API Credentials
# =============================================================================

# Unified Data Library (UDL) API Token
# Obtain from: https://unifieddatalibrary.com
# Format: Base64-encoded credentials
UDL_TOKEN=your_base64_encoded_udl_token_here

# European Space Agency (ESA) API Token
# Obtain from: https://discosweb.esoc.esa.int
ESA_TOKEN=your_esa_api_token_here

# =============================================================================
# Orekit Configuration
# =============================================================================

# Path to Orekit data directory
# Download from: https://gitlab.orekit.org/orekit/orekit-data
OREKIT_DATA_PATH=./orekit-data-main

# =============================================================================
# Database Configuration
# =============================================================================

# Database Backend: 'duckdb' (default) or 'postgres'/'supabase'
# - 'duckdb': Local file-based database (recommended for local development)
# - 'postgres' or 'supabase': Remote PostgreSQL database (shared data, production use)
DATABASE_BACKEND=duckdb

# DuckDB Configuration (used when DATABASE_BACKEND=duckdb)
# Path to the DuckDB database file (optional, has sensible default)
# DATABASE_PATH=./data/database/uct_benchmark.duckdb

# =============================================================================
# PostgreSQL/Supabase Configuration (used when DATABASE_BACKEND=postgres)
# =============================================================================
#
# IMPORTANT: If DATABASE_URL is NOT set, a READ-ONLY connection to the shared
# UCT Benchmark Supabase instance is used automatically. This allows you to:
# - Browse and download existing datasets
# - Run benchmarks against shared data
#
# For FULL ACCESS (create datasets, modify data), you need to set DATABASE_URL:
#
# Option 1: Use the shared Supabase with write access (contact admin for password)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Option 2: Use your own Supabase project
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres
#
# Option 3: Use a local PostgreSQL server
# DATABASE_URL=postgresql://postgres:password@localhost:5432/uct_benchmark

# Connection Pool Settings (PostgreSQL only)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# =============================================================================
# Test Database Configuration (Optional)
# =============================================================================

# Backend for tests: 'duckdb' (default) or 'postgres'
# TEST_DATABASE_BACKEND=duckdb

# PostgreSQL URL for tests (used when TEST_DATABASE_BACKEND=postgres)
# TEST_DATABASE_URL=postgresql://postgres:testpassword@localhost:5433/uct_benchmark_test

# =============================================================================
# Application Settings (Optional)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Backend API port
# API_PORT=8000

# =============================================================================
# Docker / Production Configuration
# =============================================================================
# These settings are used by docker-compose.yml

# PostgreSQL credentials (REQUIRED for Docker deployment)
# POSTGRES_USER=uct_benchmark
# POSTGRES_PASSWORD=change_me_in_production
# POSTGRES_DB=uct_benchmark

# Service ports exposed on the host
# FRONTEND_PORT=80
# API_PORT=8000
# DB_PORT=5432

# CORS allowed origins (comma-separated, for production domain)
# WARNING: MUST be set in production or frontend cannot reach the API.
# CORS_ORIGINS=https://your-domain.com

# Encryption key for API tokens stored in database (REQUIRED for postgres backend)
# Generate with: python -c "from backend_api.utils.crypto import generate_key; print(generate_key())"
# ENCRYPTION_KEY=your_fernet_key_here

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# Authentication Configuration
# =============================================================================

# Supabase project URL (enables ES256 JWKS production authentication)
# SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous key (for frontend client)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase JWT secret (HS256 fallback, used when SUPABASE_URL is not set)
# SUPABASE_JWT_SECRET=your-jwt-secret

# Allow HS256 JWT fallback when ES256 JWKS is primary (default: false)
# ALLOW_HS256_FALLBACK=false

# Application environment (set to 'development' ONLY for local dev without auth)
# WARNING: dev mode is blocked when SUPABASE_URL is set
# ENVIRONMENT=production

# =============================================================================
# Railway / Production Deployment
# =============================================================================

# Number of uvicorn workers (keep at 1 until JobManager uses shared state)
# WEB_WORKERS=1

# Backend URL for nginx proxy (set by Railway service networking)
# BACKEND_URL=http://backend.railway.internal:8000

# =============================================================================
# Frontend Build Variables (VITE_* prefix required)
# =============================================================================

# Cesium Ion token for 3D orbit viewer (optional but recommended).
# Free tier at https://cesium.com/ion/signup. Without it, the 3D globe on
# DatasetDetailPage / ResultsPage / LandingPage hero still renders, but
# uses Cesium's watermarked default imagery.
# VITE_CESIUM_ION_TOKEN=your-cesium-ion-token

# Feature flag for the 3D globe (optional, default: enabled when unset).
# Set to 'false' to force the SVG fallback on every page — useful if Cesium
# causes issues in a particular deployment environment.
# VITE_ENABLE_GLOBE=true

# Enable feedback widget (optional, default: false)
# VITE_FEEDBACK_ENABLED=true

# Sentry DSN for frontend error tracking (optional)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
