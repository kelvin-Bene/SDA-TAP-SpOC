# UCT-Benchmark Environment Configuration
# Copy this file to .env and fill in your credentials
# IMPORTANT: Never commit .env to version control

# =============================================================================
# Credential Encryption (Optional)
# =============================================================================
# Required to store credentials encrypted in the database via the Settings UI.
# Without this key, the system uses only .env variables for credentials.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or use the API: POST /api/v1/credentials/generate-key
CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# API Credentials
# =============================================================================
# These .env variables serve as fallbacks when DB credentials are not configured.
# You can also configure credentials via the Settings UI at /settings.

# Unified Data Library (UDL) API Token
# Obtain from: https://unifieddatalibrary.com
# Format: Base64-encoded credentials
UDL_TOKEN=your_base64_encoded_udl_token_here

# European Space Agency (ESA) API Token
# Obtain from: https://discosweb.esoc.esa.int
ESA_TOKEN=your_esa_api_token_here

# NASA Earthdata JWT Token
# Obtain from: https://urs.earthdata.nasa.gov
# NASA_EARTHDATA_TOKEN=your_nasa_earthdata_token_here

# Space-Track.org Credentials
# Register at: https://www.space-track.org/auth/createAccount
# SPACETRACK_USER=your_spacetrack_username
# SPACETRACK_PASS=your_spacetrack_password

# =============================================================================
# Orekit Configuration
# =============================================================================

# Path to Orekit data directory
# Download from: https://gitlab.orekit.org/orekit/orekit-data
OREKIT_DATA_PATH=./orekit-data-main

# =============================================================================
# Database Backend Selection
# =============================================================================

# Backend: "duckdb" (default, local development) or "postgres" (production/Supabase)
# DB_BACKEND=duckdb

# DuckDB file path (only used when DB_BACKEND=duckdb)
# DATABASE_PATH=

# =============================================================================
# Supabase / PostgreSQL Configuration
# =============================================================================
# Required when DB_BACKEND=postgres

# Supabase project URL (e.g., https://your-project.supabase.co)
# SUPABASE_URL=

# Supabase anonymous key (safe for frontend, respects RLS)
# SUPABASE_ANON_KEY=

# Supabase service role key (bypasses RLS, backend only)
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (for verifying auth tokens in FastAPI)
# SUPABASE_JWT_SECRET=

# Direct PostgreSQL connection URL
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Connection pool settings
# PG_POOL_MIN=2
# PG_POOL_MAX=10

# =============================================================================
# Authentication (Optional)
# =============================================================================

# Enable Supabase Auth JWT verification on API endpoints
# AUTH_ENABLED=false

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Application Settings (Optional)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Backend API port
# API_PORT=8000
